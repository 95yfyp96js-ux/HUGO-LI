// Small Lending OS v1.0 — Prisma schema
// Money fields are integer minor units (e.g. cents). See docs/database.md
// and docs/decision-log.md for why (Prisma Decimal is unsupported on the
// SQLite connector). Schema avoids SQLite-only features so a move to
// PostgreSQL is a provider swap, not a redesign.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// RBAC
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  displayName  String
  passwordHash String
  status       String     @default("ACTIVE") // ACTIVE | DISABLED
  roles        UserRole[]
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  auditLogs        AuditLog[]
  createdCustomers Customer[]       @relation("CustomerCreatedBy")
  collectionCases  CollectionCase[] @relation("CollectionAssignee")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique // ADMIN | MANAGER | LOAN_OFFICER | COLLECTOR | AUDITOR
  name        String
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
}

model Permission {
  id    String           @id @default(uuid())
  code  String           @unique
  roles RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id])
  permission   Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String
  roleId String
  user   User   @relation(fields: [userId], references: [id])
  role   Role   @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
}

// ---------------------------------------------------------------------------
// Customer
// ---------------------------------------------------------------------------

model Customer {
  id                 String   @id @default(uuid())
  customerNumber     String   @unique
  name               String
  identityNumber     String   @unique
  dateOfBirth        DateTime
  phone              String
  email              String?
  address            String?
  employmentStatus   String?
  employer           String?
  monthlyIncomeCents Int?
  status             String   @default("ACTIVE") // ACTIVE | INACTIVE | BLOCKED | ARCHIVED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  createdById        String?
  createdBy          User?    @relation("CustomerCreatedBy", fields: [createdById], references: [id])

  notes           CustomerNote[]
  applications    LendingApplication[]
  loans           Loan[]
  payments        Payment[]
  moneyEvents     MoneyEvent[]
  collectionCases CollectionCase[]
  riskAssessments RiskAssessment[]
  lendingLimits   LendingLimit[]

  @@index([status])
}

model CustomerNote {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id])
  note       String
  createdAt  DateTime @default(now())
  createdBy  String
}

// ---------------------------------------------------------------------------
// Lending Application
// ---------------------------------------------------------------------------

model LendingApplication {
  id                   String       @id @default(uuid())
  applicationNumber    String       @unique
  customerId           String
  customer             Customer     @relation(fields: [customerId], references: [id])
  // Null for a freeform loan slip (§ loan slip): a product there is only a
  // template the officer may prefill from, never a requirement.
  requestedProductId   String?
  requestedProduct     LoanProduct? @relation(fields: [requestedProductId], references: [id])
  requestedAmountCents Int
  requestedTermCount   Int
  purpose              String?
  incomeCents          Int?
  existingDebtCents    Int?
  status               String       @default("DRAFT") // DRAFT | SUBMITTED | UNDER_REVIEW | RISK_REVIEW | APPROVED | REJECTED | CANCELLED | EXPIRED
  // Set only when this application was created by the loan-slip fast path
  // (issueLoanSlip), so a retried submit can be recognised and replayed
  // instead of writing a second loan. Null for every normally-underwritten
  // application.
  slipIdempotencyKey   String?      @unique
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  riskAssessments RiskAssessment[]
  lendingLimits   LendingLimit[]
  loanOffers      LoanOffer[]
  approvals       LoanApproval[]
  loan            Loan?

  @@index([status])
  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Risk
// ---------------------------------------------------------------------------

model RiskAssessment {
  id            String              @id @default(uuid())
  customerId    String
  customer      Customer            @relation(fields: [customerId], references: [id])
  applicationId String?
  application   LendingApplication? @relation(fields: [applicationId], references: [id])
  score         Int
  grade         String // A | B | C | D | E
  decision      String // AUTO_APPROVE | REVIEW_REQUIRED | HIGH_RISK | REJECT
  reasons       String // JSON-encoded string[]
  modelVersion  String
  createdAt     DateTime            @default(now())

  factors RiskFactor[]

  @@index([customerId])
  @@index([applicationId])
}

model RiskFactor {
  id               String         @id @default(uuid())
  riskAssessmentId String
  riskAssessment   RiskAssessment @relation(fields: [riskAssessmentId], references: [id])
  code             String
  label            String
  value            String
  points           Int
}

// ---------------------------------------------------------------------------
// Lending Limit
// ---------------------------------------------------------------------------

model LendingLimit {
  id                     String              @id @default(uuid())
  customerId             String
  customer               Customer            @relation(fields: [customerId], references: [id])
  applicationId          String?
  application            LendingApplication? @relation(fields: [applicationId], references: [id])
  maximumLimitCents      Int
  currentExposureCents   Int
  availableLimitCents    Int
  requestedAmountCents   Int
  recommendedAmountCents Int
  decision               String // LIMIT_AVAILABLE | LIMIT_EXCEEDED
  reasons                String              @default("[]")
  engineVersion          String
  createdAt              DateTime            @default(now())

  @@index([customerId])
}

// ---------------------------------------------------------------------------
// Product / Pricing
// ---------------------------------------------------------------------------

model LoanProduct {
  id                String   @id @default(uuid())
  productCode       String
  name              String
  description       String?
  minAmountCents    Int
  maxAmountCents    Int
  minTermCount      Int
  maxTermCount      Int
  // What minTermCount/maxTermCount are counted in. A term of "7" means seven
  // days under DAY and seven months under MONTH, and the rate period is
  // converted to match, so a daily-rate product and a monthly-rate product
  // are the same arithmetic with a different period.
  termUnit          String   @default("MONTH") // DAY | MONTH
  ratePercent       Float // percent per rateUnit, e.g. 2.5 = 2.5%
  rateUnit          String // DAILY | MONTHLY | ANNUAL
  calculationMethod String // SIMPLE_INTEREST | AMORTIZED | COMPOUND | CUSTOM
  repaymentMethod   String // INTEREST_ONLY | PRINCIPAL_AND_INTEREST | PRINCIPAL_ONLY | BULLET | CUSTOM
  // How interest is treated when a loan settles early. Part of the priced
  // terms, so changing it versions the product (see docs/business-rules).
  settlementPolicy  String   @default("FULL_CONTRACT_INTEREST") // FULL_CONTRACT_INTEREST | UNACCRUED_INTEREST_REBATE
  status            String   @default("ACTIVE") // ACTIVE | INACTIVE | ARCHIVED
  version           Int      @default(1)
  feeRules          String   @default("[]") // JSON-encoded FeeRule[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  applications LendingApplication[]
  loanOffers   LoanOffer[]

  @@unique([productCode, version])
}

model LoanOffer {
  id                  String             @id @default(uuid())
  applicationId       String
  application         LendingApplication @relation(fields: [applicationId], references: [id])
  productId           String
  product             LoanProduct        @relation(fields: [productId], references: [id])
  approvedAmountCents Int
  ratePercent         Float
  rateUnit            String
  calculationMethod   String
  termCount           Int
  termUnit            String             @default("MONTH") // DAY | MONTH
  feesCents           Int
  repaymentMethod     String
  settlementPolicy    String             @default("FULL_CONTRACT_INTEREST")
  totalInterestCents  Int
  totalPayableCents   Int
  pricingVersion      String
  createdAt           DateTime           @default(now())

  approvals LoanApproval[]
}

// ---------------------------------------------------------------------------
// Approval
// ---------------------------------------------------------------------------

model LoanApproval {
  id                  String             @id @default(uuid())
  applicationId       String
  application         LendingApplication @relation(fields: [applicationId], references: [id])
  loanOfferId         String?
  loanOffer           LoanOffer?         @relation(fields: [loanOfferId], references: [id])
  decision            String // PENDING | APPROVED | REJECTED | CONDITIONAL
  approvedAmountCents Int?
  approvedTermCount   Int?
  approvedRatePercent Float?
  conditions          String             @default("[]") // JSON-encoded ApprovalCondition[]
  reason              String?
  approvedBy          String?
  approvedAt          DateTime?
  createdAt           DateTime           @default(now())

  @@index([applicationId])
}

// ---------------------------------------------------------------------------
// Loan
// ---------------------------------------------------------------------------

model Loan {
  id                        String             @id @default(uuid())
  loanNumber                String             @unique
  customerId                String
  customer                  Customer           @relation(fields: [customerId], references: [id])
  applicationId             String             @unique
  application               LendingApplication @relation(fields: [applicationId], references: [id])
  // Null for a freeform loan slip with no template product.
  productId                 String?
  principalCents            Int
  outstandingPrincipalCents Int
  outstandingInterestCents  Int
  outstandingFeeCents       Int                @default(0)
  status                    String             @default("CREATED")
  startDate                 DateTime?
  maturityDate              DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt

  snapshot         LoanSnapshot?
  disbursements    Disbursement[]
  scheduleLines    ScheduleLine[]
  payments         Payment[]
  moneyEvents      MoneyEvent[]
  interestAccruals InterestAccrual[]
  collectionCases  CollectionCase[]
  extensions       Extension[]
  settlement       Settlement?

  renewalsAsOriginal Renewal[] @relation("RenewalOriginal")
  renewalsAsPrevious Renewal[] @relation("RenewalPrevious")
  renewalAsNew       Renewal?  @relation("RenewalNew")

  @@index([status])
  @@index([customerId])
}

// Immutable once written. If terms must change, write a LoanAdjustment row —
// never UPDATE the pricing/product columns here.
model LoanSnapshot {
  id                    String   @id @default(uuid())
  loanId                String   @unique
  loan                  Loan     @relation(fields: [loanId], references: [id])
  principalCents        Int
  ratePercent           Float
  rateUnit              String
  calculationMethod     String
  termCount             Int
  termUnit              String   @default("MONTH") // DAY | MONTH
  repaymentMethod       String
  settlementPolicy      String   @default("FULL_CONTRACT_INTEREST")
  // Both null when the loan slip that created this loan named no template
  // product; snapshotted like every other term here so a later repricing —
  // or the template being deleted — cannot change what this loan agreed to.
  productId             String?
  productVersion        Int?
  feeRules              String
  pricingVersion        String
  riskAssessmentVersion String
  approvalVersion       String
  // 逾期利率 (optional). Recorded on the slip for reference only — v1's
  // OverdueEngine tracks delinquency status but does not accrue penalty
  // interest, so this is not automatically applied to the balance.
  overdueRatePercent    Float?
  // POST_PAID (interest collected via the schedule, as every method already
  // does) is the only value ever written. PRE_PAID (interest deducted from
  // the amount disbursed) is a real option on the loan slip form but is
  // rejected at input time — see LoanService.issueLoanSlip — because nothing
  // in the disbursement or schedule engines implements it. The column exists
  // so the limitation is visible in the data model, not silently absent.
  interestTiming        String   @default("POST_PAID")
  createdAt             DateTime @default(now())

  adjustments LoanAdjustment[]
}

model LoanAdjustment {
  id         String       @id @default(uuid())
  snapshotId String
  snapshot   LoanSnapshot @relation(fields: [snapshotId], references: [id])
  reason     String
  changes    String // JSON-encoded diff
  createdAt  DateTime     @default(now())
  createdBy  String
}

model Disbursement {
  id                 String    @id @default(uuid())
  disbursementNumber String    @unique
  loanId             String
  loan               Loan      @relation(fields: [loanId], references: [id])
  amountCents        Int
  method             String
  reference          String?
  status             String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | FAILED | CANCELLED
  idempotencyKey     String    @unique
  // Invariant §74.5, enforced by the database rather than by a status check.
  // Set to the loan id only while this disbursement is COMPLETED, and left
  // null otherwise, so a loan can have any number of FAILED attempts but the
  // second *successful* one is refused by this unique index. The status check
  // alone could not do that: two requests with different idempotency keys both
  // read the same pre-disbursement status and both paid out.
  completedForLoanId String?   @unique
  processedAt        DateTime?
  processedBy        String?
  createdAt          DateTime  @default(now())
}

model ScheduleLine {
  id                 String   @id @default(uuid())
  loanId             String
  loan               Loan     @relation(fields: [loanId], references: [id])
  installmentNumber  Int
  dueDate            DateTime
  principalDueCents  Int
  interestDueCents   Int
  feeDueCents        Int      @default(0)
  totalDueCents      Int
  principalPaidCents Int      @default(0)
  interestPaidCents  Int      @default(0)
  feePaidCents       Int      @default(0)
  status             String   @default("PENDING") // PENDING | PARTIALLY_PAID | PAID | OVERDUE

  // Durable record of which payment funded how much of this installment, and
  // when. Without this, ScheduleLine.paidCents is only a running total — it
  // cannot say whether a given cent arrived today or three weeks ago, which
  // the daily close (今日應收/實收/未收) needs to answer precisely.
  paymentAllocations ScheduleLineAllocation[]

  @@unique([loanId, installmentNumber])
  @@index([loanId, dueDate])
}

model InterestAccrual {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id])
  periodStart DateTime
  periodEnd   DateTime
  days        Int
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([loanId])
}

// ---------------------------------------------------------------------------
// Payments
// ---------------------------------------------------------------------------

model Payment {
  id             String   @id @default(uuid())
  paymentNumber  String   @unique
  loanId         String
  loan           Loan     @relation(fields: [loanId], references: [id])
  customerId     String
  customer       Customer @relation(fields: [customerId], references: [id])
  amountCents    Int
  method         String
  status         String   @default("CONFIRMED") // PENDING | CONFIRMED | FAILED | REVERSED
  idempotencyKey String   @unique
  paidAt         DateTime
  createdBy      String
  createdAt      DateTime @default(now())

  allocations             PaymentAllocation[]
  scheduleLineAllocations ScheduleLineAllocation[]

  @@index([loanId])
}

model PaymentAllocation {
  id                   String  @id @default(uuid())
  paymentId            String
  payment              Payment @relation(fields: [paymentId], references: [id])
  principalAmountCents Int
  interestAmountCents  Int
  feeAmountCents       Int
}

// One row per (payment, installment) touched by that payment's allocation.
// PaymentAllocation above is the payment's own principal/interest/fee split;
// this is the same split broken down per ScheduleLine, which is what lets
// the daily close attribute "how much of today's money paid down today's due
// installments" versus an older or future one. Written once, at apply time,
// and never adjusted afterwards — a reversal is excluded by the reversed
// payment's own status, not by editing these rows (§74.12: history is added
// to, never rewritten).
model ScheduleLineAllocation {
  id                   String       @id @default(uuid())
  paymentId            String
  payment              Payment      @relation(fields: [paymentId], references: [id])
  scheduleLineId       String
  scheduleLine         ScheduleLine @relation(fields: [scheduleLineId], references: [id])
  principalAmountCents Int
  interestAmountCents  Int
  feeAmountCents       Int
  createdAt            DateTime     @default(now())

  @@index([scheduleLineId])
  @@index([paymentId])
}

// Append-only financial ledger. Never DELETE or mutate; a reversal is a new
// PAYMENT_REVERSAL row.
model MoneyEvent {
  id          String   @id @default(uuid())
  loanId      String
  loan        Loan     @relation(fields: [loanId], references: [id])
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  type        String // DISBURSEMENT | INTEREST_ACCRUAL | FEE_CHARGE | PAYMENT | PAYMENT_REVERSAL | ADJUSTMENT | WRITE_OFF | SETTLEMENT
  amountCents Int
  referenceId String?
  occurredAt  DateTime
  createdBy   String
  metadata    String   @default("{}")
  createdAt   DateTime @default(now())

  @@index([loanId])
  @@index([type])
}

// ---------------------------------------------------------------------------
// Collections
// ---------------------------------------------------------------------------

model CollectionCase {
  id                     String    @id @default(uuid())
  caseNumber             String    @unique
  loanId                 String
  loan                   Loan      @relation(fields: [loanId], references: [id])
  customerId             String
  customer               Customer  @relation(fields: [customerId], references: [id])
  daysOverdue            Int
  outstandingAmountCents Int
  priority               String // LOW | MEDIUM | HIGH | CRITICAL
  status                 String    @default("OPEN") // OPEN | IN_PROGRESS | PROMISE_TO_PAY | ESCALATED | PAID | CLOSED
  assignedUserId         String?
  assignedUser           User?     @relation("CollectionAssignee", fields: [assignedUserId], references: [id])
  nextActionAt           DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  activities CollectionActivity[]
  promises   PromiseToPay[]

  @@index([status])
  @@index([loanId])
}

model CollectionActivity {
  id               String         @id @default(uuid())
  collectionCaseId String
  collectionCase   CollectionCase @relation(fields: [collectionCaseId], references: [id])
  type             String // PHONE | SMS | EMAIL | IN_PERSON | SYSTEM | OTHER
  result           String?
  note             String?
  createdBy        String
  createdAt        DateTime       @default(now())
  nextActionAt     DateTime?
}

model PromiseToPay {
  id                  String         @id @default(uuid())
  collectionCaseId    String
  collectionCase      CollectionCase @relation(fields: [collectionCaseId], references: [id])
  promisedAmountCents Int
  promisedDate        DateTime
  status              String         @default("PENDING") // PENDING | KEPT | BROKEN
  createdBy           String
  createdAt           DateTime       @default(now())
}

// ---------------------------------------------------------------------------
// Renewal / Extension / Settlement
// ---------------------------------------------------------------------------

model Renewal {
  id             String   @id @default(uuid())
  // Without this a retried renew request created a second loan carrying the
  // same balance forward — duplicate lending. Nullable so historical rows
  // remain valid; enforced for every new renewal by the service.
  idempotencyKey String?  @unique
  originalLoanId String
  originalLoan   Loan     @relation("RenewalOriginal", fields: [originalLoanId], references: [id])
  previousLoanId String
  previousLoan   Loan     @relation("RenewalPrevious", fields: [previousLoanId], references: [id])
  newLoanId      String   @unique
  newLoan        Loan     @relation("RenewalNew", fields: [newLoanId], references: [id])
  reason         String
  createdAt      DateTime @default(now())
  createdBy      String

  @@index([originalLoanId])
}

model Extension {
  id                   String   @id @default(uuid())
  idempotencyKey       String?  @unique
  loanId               String
  loan                 Loan     @relation(fields: [loanId], references: [id])
  previousMaturityDate DateTime
  newMaturityDate      DateTime
  extensionMonths      Int
  feeCents             Int      @default(0)
  reason               String
  createdAt            DateTime @default(now())
  createdBy            String

  @@index([loanId])
}

model Settlement {
  id                 String   @id @default(uuid())
  loanId             String   @unique
  loan               Loan     @relation(fields: [loanId], references: [id])
  principalPaidCents Int
  interestPaidCents  Int
  feesPaidCents      Int
  totalPaidCents     Int
  settledAt          DateTime
  settledBy          String
  createdAt          DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id         String   @id @default(uuid())
  ownerType  String // CUSTOMER | LOAN | APPLICATION
  ownerId    String
  fileName   String
  mimeType   String
  sizeBytes  Int
  storageRef String
  createdAt  DateTime @default(now())
  createdBy  String

  @@index([ownerType, ownerId])
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  action     String
  resource   String
  resourceId String
  before     String?
  after      String?
  reason     String?
  timestamp  DateTime @default(now())
  ip         String?
  metadata   String   @default("{}")

  @@index([resource, resourceId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Idempotency
// ---------------------------------------------------------------------------

model IdempotencyRecord {
  key          String   @id
  endpoint     String
  /**
   * Hash of the request body, so the same key with different content is refused.
   */
  fingerprint  String   @default("")
  statusCode   Int      @default(200)
  responseBody String
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Shop settings
// ---------------------------------------------------------------------------

// Singleton row (id is always "default"). A shop-wide policy, not a
// per-product field: it caps every product's rate, present and future,
// expressed as a monthly-equivalent so a daily, monthly or annual rate can
// all be checked against the one number (see shared/taipeiDay.js sibling
// periodRate conversion). Changing it never touches an existing LoanSnapshot
// — it only gates what may be saved or approved from this point on.
model ShopSettings {
  id                    String   @id @default("default")
  maxMonthlyRatePercent Float?
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

// ---------------------------------------------------------------------------
// Daily close
// ---------------------------------------------------------------------------

// One row per Asia/Taipei calendar day that has ever been closed. Absence of
// a row means the day is open. Reopening does not delete the row — it flips
// status and records who/why, so the close/reopen history is never lost
// (§74.12 in spirit: history is added to, not rewritten).
model DailyClose {
  id           String    @id @default(uuid())
  date         String    @unique // YYYY-MM-DD, Asia/Taipei
  status       String    @default("CLOSED") // CLOSED | REOPENED
  closedAt     DateTime  @default(now())
  closedBy     String?
  reopenedAt   DateTime?
  reopenedBy   String?
  reopenReason String?

  @@index([date])
}
